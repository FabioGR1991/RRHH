# Configuración General del Servidor
APP_NAME="Plataforma RRHH - IT Onboarding"
ENV="development"
PORT=8000

# Base de Datos Local
DATABASE_URL="sqlite:///./rrhh_onboarding.db"

# Active Directory (AD)
AD_SERVER="192.168.1.10"
AD_DOMAIN="tandemtech.com.ar"
AD_ADMIN_USER="admin_it"
AD_ADMIN_PASSWORD="TuPasswordSeguro"

# Google Admin Workspace
GOOGLE_SERVICE_ACCOUNT_FILE="./config/google_credentials.json"
GOOGLE_ADMIN_EMAIL="admin@tandemtech.com.ar"

# NeoTel API
NEOTEL_API_URL="https://neotel.tuempresa.com/api"
NEOTEL_API_KEY="TuApiKeyDeNeoTel"

# Fortinet / FortiGate SSH
FORTIGATE_HOST="192.168.1.1"
FORTIGATE_PORT=22
FORTIGATE_USER="admin_forti"
FORTIGATE_PASSWORD="TuPasswordForti"

# Servidor SMTP para Notificaciones por Correo
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones@tandemtech.com.ar"
SMTP_PASSWORD="TuPasswordDeAplicacion"